{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "esModuleInterop": true, "skipLibCheck": true,
    "resolveJsonModule": true, "jsx": "react-jsx", "noEmit": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@meteor-flow/contracts": ["packages/contracts/src/index.ts"],
      "@meteor-flow/posix-fs": ["packages/posix-fs/src/index.ts"]
    }
  },
  "include": ["apps/**/*.ts", "apps/**/*.tsx", "packages/**/*.ts", "tests/**/*.ts", "*.config.ts"],
  "exclude": ["**/dist", "**/node_modules"]
}
