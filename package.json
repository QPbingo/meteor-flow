{
  "name": "meteor-flow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test tests/e2e --workers=1",
    "start": "node apps/server/dist/cli/main.js",
    "dev": "node scripts/dev.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "@playwright/test": "1.63.0",
    "@playwright/cli": "0.1.22",
    "@types/node": "24.19.1",
    "tsx": "4.23.15"
  }
}
